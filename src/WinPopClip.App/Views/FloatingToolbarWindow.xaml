<Window x:Class="WinPopClip.App.Views.FloatingToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False">
    <Grid x:Name="RootGrid" Margin="16" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="PopScaleTransform" ScaleX="1" ScaleY="1" />
                <TranslateTransform x:Name="SlideTransform" Y="0" />
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- Actions Capsule + Material Layers + Optional Inline Theme Switcher -->
        <StackPanel x:Name="ActionsContainer" Visibility="Visible" HorizontalAlignment="Center">
            <Polygon x:Name="TopPointer"
                     Points="0,6 6,0 12,6"
                     HorizontalAlignment="Center"
                     Visibility="Collapsed"
                     Fill="#D2181B25" />

            <Border x:Name="PillBorder"
                    CornerRadius="14"
                    BorderThickness="1.15"
                    SnapsToDevicePixels="True"
                    ClipToBounds="False">
                <Border.Effect>
                    <DropShadowEffect x:Name="PillShadow" Color="#000000" BlurRadius="22" ShadowDepth="6" Opacity="0.32" />
                </Border.Effect>

                <Grid>
                    <!-- Layer 1: Acrylic micro-grain frosted noise overlay -->
                    <Border x:Name="AcrylicNoiseLayer"
                            CornerRadius="13"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />

                    <!-- Layer 2: Liquid Glass top specular lens refraction & caustic inner rim -->
                    <Border x:Name="LiquidGlassSheenLayer"
                            CornerRadius="13"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">
                        <Grid>
                            <Border x:Name="LiquidGlassTopHighlight"
                                    VerticalAlignment="Top"
                                    Height="22"
                                    CornerRadius="12,12,4,4"
                                    Margin="1,1,1,0" />
                            <Border x:Name="LiquidGlassInnerRim"
                                    CornerRadius="12.5"
                                    BorderThickness="1"
                                    Margin="0.5" />
                        </Grid>
                    </Border>

                    <!-- Layer 3: Foreground Interactive Content (adapts to Auto / Presets / Custom WxH) -->
                    <StackPanel x:Name="ContentStack" Orientation="Vertical" Margin="6,5" VerticalAlignment="Center">
                        <ScrollViewer x:Name="ActionsScrollViewer"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Disabled"
                                      Focusable="False">
                            <Grid x:Name="ActionsHostGrid" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </ScrollViewer>

                        <!-- Inline non-activating 3-option Theme Switcher Strip -->
                        <Border x:Name="ThemeSwitcherPanel"
                                Visibility="Collapsed"
                                Margin="2,6,2,1"
                                Padding="4,4"
                                CornerRadius="9"
                                BorderThickness="1">
                            <StackPanel x:Name="ThemeOptionsStack" Orientation="Horizontal" HorizontalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Polygon x:Name="BottomPointer"
                     Points="0,0 12,0 6,6"
                     HorizontalAlignment="Center"
                     Visibility="Visible"
                     Fill="#D2181B25" />
        </StackPanel>

        <!-- HUD Toast Feedback Pill -->
        <Border x:Name="ToastBorder"
                Visibility="Collapsed"
                CornerRadius="12"
                Padding="13,9"
                MaxWidth="420"
                BorderThickness="1.15">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="5" Opacity="0.32" />
            </Border.Effect>
            <DockPanel LastChildFill="True">
                <Button x:Name="ToastCopyButton"
                        DockPanel.Dock="Right"
                        Content="复制"
                        Margin="10,0,0,0"
                        Padding="10,4"
                        FontSize="12"
                        Focusable="False"
                        Cursor="Hand"
                        Foreground="#FFFFFF"
                        Background="#4F46E5"
                        BorderThickness="0"
                        Click="OnToastCopyClick" />
                <TextBlock x:Name="ToastTextBlock"
                           FontSize="13"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
