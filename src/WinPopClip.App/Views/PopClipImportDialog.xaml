<Window x:Class="WinPopClip.App.Views.PopClipImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selector — 导入 PopClip Snippet 插件"
        Icon="pack://application:,,,/Assets/selector.ico"
        Width="600"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource AppBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource TextFont}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="粘贴 macOS PopClip Snippet（支持 #popclip YAML 或 // #popclip JS 脚本）"
                       FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="提示：也可以直接在任意浏览器中划选一段 #popclip 文本，浮动栏会自动出现「一键安装」按钮。"
                       FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
        </StackPanel>

        <TextBox x:Name="SnippetBox"
                 Grid.Row="1"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12.5"
                 Padding="10"
                 TextChanged="OnSnippetTextChanged" />

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrushTheme}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,10,0,12">
            <TextBlock x:Name="PreviewText"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="填入 JS 示例" Padding="10,6" Margin="0,0,8,0" Click="OnLoadJsSampleClick" />
            <Button Content="填入 URL 示例" Padding="10,6" Margin="0,0,14,0" Click="OnLoadUrlSampleClick" />
            <Button Content="取消" Width="84" Padding="0,6" Margin="0,0,8,0" IsCancel="True" />
            <Button x:Name="ImportButton"
                    Content="导入并启用"
                    Width="104"
                    Padding="0,6"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="White"
                    BorderThickness="0"
                    IsDefault="True"
                    Click="OnImportClick" />
        </StackPanel>
    </Grid>
</Window>
